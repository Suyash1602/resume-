      font-size: 13px;
      color: #1a1a1a;
      background: #f0f2f5;
      -webkit-font-smoothing: antialiased;
    }

    .page {
      max-width: 860px;
      margin: 30px auto;
      background: #fff;
      padding: 40px 48px;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.10);
      border-radius: 4px;
    }

    /* Header */
    .header {
      border-bottom: 2.5px solid #1a56db;
      padding-bottom: 14px;
      margin-bottom: 16px;
    }

    .name {
      font-size: 26px;
      font-weight: 800;
      letter-spacing: 0.5px;
      color: #0f172a;
    }

    .title-tag {
      font-size: 13.5px;
      font-weight: 600;
      color: #1a56db;
      margin: 3px 0 10px;
      letter-spacing: 0.2px;
    }

    .contact {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 18px;
      font-size: 12px;
      color: #374151;
    }

    .contact a {
      color: #1a56db;
      text-decoration: none;
    }

    /* Section */
    .section {
      margin-bottom: 18px;
    }

    .section-title {
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 1.4px;
      text-transform: uppercase;
      color: #1a56db;
      border-bottom: 1px solid #dbeafe;
      padding-bottom: 4px;
      margin-bottom: 10px;
    }

    .summary p {
      line-height: 1.6;
      color: #374151;
      font-size: 12.5px;
    }

    /* Skills */
    .skills-grid {
      display: grid;
      grid-template-columns: 130px 1fr;
      gap: 2px 0;
    }

    .skill-cat {
      font-weight: 700;
      color: #0f172a;
      font-size: 12px;
      padding: 2px 0;
    }

    .skill-val {
      color: #374151;
      font-size: 12px;
      padding: 2px 0;
      border-bottom: 1px dashed #f1f5f9;
    }

    /* Experience */
    .job {
      margin-bottom: 14px;
    }

    .job-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 2px;
    }

    .job-title {
      font-weight: 800;
      font-size: 13.5px;
      color: #0f172a;
    }

    .job-date {
      font-size: 12px;
      color: #6b7280;
    }

    .job-company {
      font-size: 12.5px;
      color: #1a56db;
      font-weight: 600;
      margin-bottom: 6px;
    }

    .job ul, .project ul {
      padding-left: 16px;
    }

    .job li, .project li {
      margin-bottom: 4px;
      line-height: 1.5;
      color: #374151;
    }

    /* Projects */
    .project {
      margin-bottom: 12px;
    }

    .project-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
    }

    .project-name {
      font-weight: 800;
      font-size: 13px;
      color: #0f172a;
    }

    .project-stack {
      font-size: 11.5px;
      color: #6b7280;
      font-weight: 400;
    }

    .project-link {
      font-size: 11.5px;
      color: #1a56db;
      text-decoration: none;
    }

    /* Layout */
    .two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 32px;
    }

    .cert-item, .edu-item {
      margin-bottom: 8px;
    }

    .cert-name, .edu-degree {
      font-weight: 700;
      font-size: 13px;
      color: #0f172a;
    }

    .cert-issuer, .edu-school, .edu-meta {
      font-size: 12px;
      color: #6b7280;
    }

    /* PRINT OPTIMIZATION */
    @media print {
      @page {
        margin: 0;
        size: A4;
      }
      body {
        background: #fff;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      .page {
        box-shadow: none;
        margin: 0;
        padding: 40px 48px;
        width: 100%;
        max-width: 100%;
      }
      .contact a::after {
        content: none !important; /* Prevents showing URL next to links */
      }
    }
  </style>
</head>

